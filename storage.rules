rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isStaff() {
      return request.auth != null
        && (
          request.auth.token.email.lower() == "d.nikolova.haccp@gmail.com"
          || request.auth.token.email.lower() == "davida1991@gmail.com"
          || request.auth.token.email.lower() == "davidabg91@gmail.com"
        );
    }

    // Купените пакети на влезлия потребител (users/{email}.purchasedCourseIds).
    function purchasedIds() {
      let userPath = /databases/(default)/documents/users/$(request.auth.token.email.lower());
      return firestore.exists(userPath)
        ? firestore.get(userPath).data.get("purchasedCourseIds", [])
        : [];
    }

    // Пакетът „Практическа библия — всички части" отключва само своите три части.
    function hasPurchased(id) {
      return request.auth != null && (
        id in purchasedIds()
        || (id in ["prakticheska-biblia-chast-1", "prakticheska-biblia-chast-2", "prakticheska-biblia-chast-3"]
            && "prakticheska-biblia-paket-vsichki-chasti" in purchasedIds())
      );
    }

    // Качване и триене на файлове — само от администраторите (админ панела).
    match /courses/{courseId}/{allPaths=**} {
      allow read: if allPaths.matches('^cover\\..+')
        || isStaff()
        || hasPurchased(courseId);
      allow write: if isStaff();
    }

    match /trainings/{trainingId}/{fileName} {
      allow read: if fileName.matches('^cover\\..+');
      allow write: if isStaff();
    }

    match /library/{slug}/{allPaths=**} {
      allow read: if isStaff() || hasPurchased(slug);
      allow write: if isStaff();
    }

    match /assigned_docs/{recipient}/{fileName} {
      allow read: if request.auth != null && (
        isStaff() ||
        recipient == "all" ||
        request.auth.token.email.lower() == recipient.lower()
      );
      allow write: if isStaff();
    }
  }
}
