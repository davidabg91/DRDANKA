rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isStaff() {
      return request.auth != null
        && (
          request.auth.token.email.lower() == "d.nikolova.haccp@gmail.com"
          || request.auth.token.email.lower() == "davida1991@gmail.com"
          || request.auth.token.email.lower() == "davidabg91@gmail.com"
        );
    }

    // Check the buyer's /users/{email}.purchasedCourseIds for the courseId.
    function hasPurchased(courseId) {
      let email = request.auth.token.email.lower();
      let userPath = /databases/(default)/documents/users/$(email);
      return request.auth != null
        && firestore.exists(userPath)
        && (courseId in firestore.get(userPath).data.purchasedCourseIds
            || "prakticheska-biblia-paket-vsichki-chasti" in firestore.get(userPath).data.purchasedCourseIds);
    }

    match /courses/{courseId}/{allPaths=**} {
      allow read: if allPaths.matches('^cover\\..+')
        || isStaff()
        || hasPurchased(courseId);

      allow write: if request.auth != null;
    }

    match /trainings/{trainingId}/{fileName} {
      allow read: if fileName.matches('^cover\\..+');
      allow write: if request.auth != null;
    }

    function hasPurchasedSlug(slug) {
      let email = request.auth.token.email.lower();
      let userPath = /databases/(default)/documents/users/$(email);
      return request.auth != null
        && firestore.exists(userPath)
        && (slug in firestore.get(userPath).data.purchasedCourseIds
            || "prakticheska-biblia-paket-vsichki-chasti" in firestore.get(userPath).data.purchasedCourseIds);
    }

    match /library/{slug}/{allPaths=**} {
      allow read: if isStaff() || hasPurchasedSlug(slug);
      allow write: if request.auth != null;
    }

    match /assigned_docs/{recipient}/{fileName} {
      allow read: if request.auth != null && (
        isStaff() ||
        recipient == "all" ||
        request.auth.token.email.lower() == recipient.lower()
      );
      allow write: if request.auth != null;
    }
  }
}
